{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "59217909-3af8-4573-8d8b-397f681c621d"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "workspaceId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_variable": {
          "runAfter": {
            "Run_a_Child_Flow": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "160ce0a8-0413-45bf-aeae-271f35fa886f"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "accessToken",
                "type": "string",
                "value": "@body('Run_a_Child_Flow')?['access_token']"
              }
            ]
          }
        },
        "HTTP_2": {
          "runAfter": {
            "Initialize_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "78b9a8c9-27cd-4599-90ac-963d08b116dc"
          },
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/networking/communicationPolicy/outbound/git",
            "headers": {
              "Authorization": "Bearer @{variables('accessToken')}",
              "Accept": "application/json"
            }
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "HTTP_2": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "308f833d-a5f7-4e2f-9ec4-1defaf1f4f54"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "gitaction": "@{body('HTTP_2')?['defaultAction']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "gitaction": {
                  "title": "GitAction",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Run_a_Child_Flow": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "46fd146c-dd7b-4a6c-b558-2e2589ccf309"
          },
          "type": "Workflow",
          "inputs": {
            "host": {
              "workflowReferenceName": "50895fca-088f-f111-8076-7ced8d76bf1b"
            }
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
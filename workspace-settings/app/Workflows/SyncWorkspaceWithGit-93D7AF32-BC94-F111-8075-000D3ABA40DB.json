                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/git/commitToGit",
                    "headers": {
                      "Authorization": "Bearer @{variables('accessToken')}",
                      "Content-Type": "application/json"
                    },
                    "body": "@json(concat('{\"mode\":\"All\",\"comment\":\"Sync from Fabric workspace\"', if(empty(coalesce(body('Get_git_status')?['workspaceHead'],'')), '', concat(',\"workspaceHead\":\"', body('Get_git_status')?['workspaceHead'], '\"')), '}'))"
                  },
                  "operationOptions": "DisableAsyncPattern"
                },
                "Set_operationId_commit": {
                  "runAfter": {
                    "CommitToGit": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "98714a25-f142-4b84-b601-81d4d7afd777"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "operationId",
                    "value": "@{coalesce(outputs('CommitToGit')?['headers']?['x-ms-operation-id'], outputs('CommitToGit')?['headers']?['X-Ms-Operation-Id'], last(split(coalesce(outputs('CommitToGit')?['headers']?['Location'],''),'/')), '')}"
                  }
                },
                "Set_outcome_commit": {
                  "runAfter": {
                    "Set_operationId_commit": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "bac8e1e0-04cb-43b1-a93c-6e1368b92dd2"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "outcome",
                    "value": "@{if(equals(outputs('CommitToGit')['statusCode'],202),'Started',\r\n if(less(outputs('CommitToGit')['statusCode'],300),'Completed','Failed'))}"
                  }
                },
                "Set_message_commit": {
                  "runAfter": {
                    "Set_outcome_commit": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "7a35c344-c27d-4c31-ae27-14794ac72852"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "message",
                    "value": "@{if(equals(outputs('CommitToGit')['statusCode'],202),'Commit started.',\r\n if(less(outputs('CommitToGit')['statusCode'],300),'Workspace committed to Git.',string(body('CommitToGit'))))}"
                  }
                }
              }
            },
            "UpdateFromGit": {
              "case": "UpdateFromGit",
              "actions": {
                "Update_from_git": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "b81d8df8-9817-40c6-ba5a-988bb44e3b0d"
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/git/updateFromGit",
                    "headers": {
                      "Authorization": "Bearer @{variables('accessToken')}",
                      "Content-Type": "application/json"
                    },
                    "body": "@json(concat('{', if(empty(coalesce(body('Get_git_status')?['workspaceHead'],'')), '', concat('\"workspaceHead\":\"', body('Get_git_status')?['workspaceHead'], '\",')), '\"remoteCommitHash\":\"', body('Get_git_status')?['remoteCommitHash'], '\",\"conflictResolution\":{\"conflictResolutionType\":\"Workspace\",\"conflictResolutionPolicy\":\"', if(empty(coalesce(triggerBody()?['text_2'],'')),'PreferRemote',triggerBody()?['text_2']), '\"},\"options\":{\"allowOverrideItems\":', if(variables('allowOverride'),'true','false'), '}}'))"
                  },
                  "operationOptions": "DisableAsyncPattern"
                },
                "Set_operationId_update": {
                  "runAfter": {
                    "Update_from_git": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "ad24ed62-8721-4c47-981c-fde19fd5553d"
                  },
                  "type": "SetVariable",
                  "inputs": {

          "cases": {
            "CommitToGit": {
              "case": "CommitToGit",
              "actions": {
                "CommitToGit": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "5da28290-9cfc-4b60-ad12-7d64bea643f4"

                    "value": "@{coalesce(outputs('Update_from_git')?['headers']?['x-ms-operation-id'], outputs('Update_from_git')?['headers']?['X-Ms-Operation-Id'], last(split(coalesce(outputs('Update_from_git')?['headers']?['Location'],''),'/')), '')}"
                  }
                },
                "Set_outcome_update": {
                  "runAfter": {

{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "b96fe333-e8ed-4aa6-a695-4851ab707cab"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "workspaceId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "connectionId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "organizationName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_3": {
                  "title": "projectName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_4": {
                  "title": "repositoryName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_5": {
                  "title": "branchName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_6": {
                  "title": "directoryName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2",
                "text_3",
                "text_4",
                "text_5",
                "text_6"
              ]
            }
          }
        }
      },
      "actions": {
        "Compose": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "8f8aaa68-fe3b-4f8d-93c4-0b3b6f01dc9d"
          },
          "type": "Compose",
          "inputs": {
            "workspaceId": "@{triggerBody()?['text']}",
            "connectionId": "@{triggerBody()?['text_1']}",
            "organizationName": "@{triggerBody()?['text_2']}",
            "projectName": "@{triggerBody()?['text_3']}",
            "repositoryName": "@{triggerBody()?['text_4']}",
            "branchName": "@{triggerBody()?['text_5']}",
            "directoryName": "@{triggerBody()?['text_6']}"
          }
        },
        "Run_a_Child_Flow": {
          "runAfter": {
            "Compose": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "79664f04-7fa6-4435-b0f5-e45c305c7e69"
          },
          "type": "Workflow",
          "inputs": {
            "host": {
              "workflowReferenceName": "50895fca-088f-f111-8076-7ced8d76bf1b"
            }
          }
        },
        "Initialize_accessToken": {
          "runAfter": {
            "Run_a_Child_Flow": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "e1cfef0f-5b18-43dc-bdcb-6565f00352e5"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "accessToken",
                "type": "string",
                "value": "@body('Run_a_Child_Flow')?['access_token']"
              }
            ]
          }
        },
        "Initialize_outcome": {
          "runAfter": {
            "Initialize_accessToken": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "82635774-f6ec-4d08-a51f-2b58fbdca2b4"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "outcome",
                "type": "string",
                "value": "Failed"
              }
            ]
          }
        },
        "Initialize_message": {
          "runAfter": {
            "Initialize_outcome": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "b390254b-ffd1-4fc4-834b-2c9d598a5021"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "message",
                "type": "string"
              }
            ]
          }
        },
        "Initialize_operationId": {
          "runAfter": {
            "Initialize_message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1dcf71ed-55c1-4d93-9b58-d971aadbeaf4"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "operationId",
                "type": "string"
              }
            ]
          }
        },
        "Check_existing": {
          "runAfter": {
            "Initialize_requiredAction": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "acb65d3a-8bab-441f-ad68-75a7a5519cfd"
          },
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/git/connection",
            "headers": {
              "Authorization": "Bearer @{variables('accessToken')}",
              "Accept": "application/json"
            }
          }
        },
        "Is_not_connected": {
          "actions": {
            "Connect": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "09cc8492-7d7a-4f0e-a5ad-e2fe644c078e"
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/git/connect",
                "headers": {
                  "Authorization": "Bearer @{variables('accessToken')}",
                  "Content-Type": "application/json"
                },
                "body": {
                  "gitProviderDetails": {
                    "gitProviderType": "AzureDevOps",
                    "organizationName": "@{triggerBody()['text_2']}",
                    "projectName": "@{triggerBody()['text_3']}",
                    "repositoryName": "@{triggerBody()['text_4']}",
                    "branchName": "@{triggerBody()['text_5']}",
                    "directoryName": "@{triggerBody()['text_6']}"
                  },
                  "myGitCredentials": {
                    "source": "ConfiguredConnection",
                    "connectionId": "@{triggerBody()['text_1']}"
                  }
                }
              }
            },
            "Set_credentials": {
              "runAfter": {
                "Connect": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "75ddb802-9d99-4b23-9aa4-8cd26246d3a8"
              },
              "type": "Http",
              "inputs": {
                "method": "PATCH",
                "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/git/myGitCredentials",
                "headers": {
                  "Authorization": "Bearer @{variables('accessToken')}",
                  "Content-Type": "application/json"
                },
                "body": {
                  "source": "ConfiguredConnection",
                  "connectionId": "@{triggerBody()['text_1']}"
                }
              }
            },
            "Initialize_connection": {
              "runAfter": {
                "Set_credentials": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "953f4255-ec23-45ba-8755-460dd5ccd931"
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://api.fabric.microsoft.com/v1/workspaces/@{triggerBody()['text']}/git/initializeConnection",
                "headers": {
                  "Authorization": "Bearer @{variables('accessToken')}",
                  "Content-Type": "application/json"
                },
                "body": {
                  "initializationStrategy": "None"
                }
              }
            },
            "Set_outcome": {
              "runAfter": {
                "Initialize_connection": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "metadata": {
                "operationMetadataId": "ecc18132-503d-4a19-9d6b-be14f465c6f7"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "outcome",
                "value": "@{if(equals(coalesce(outputs('Initialize_connection')?['statusCode'],0),202),'Pending',if(less(coalesce(outputs('Initialize_connection')?['statusCode'],0),300),'Connected',if(equals(coalesce(body('Initialize_connection')?['errorCode'],''),'MissingInitializationStrategy'),'NeedsChoice','Failed')))}"
              }
            },
            "Set_requiredAction": {
              "runAfter": {
                "Set_outcome": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "4722e749-d846-466c-9dc3-4f51114e3525"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "requiredAction",
                "value": "@{if(less(coalesce(outputs('Initialize_connection')?['statusCode'],0),300),coalesce(body('Initialize_connection')?['requiredAction'],'None'),'None')}"
              }
            },
            "Set_message": {
              "runAfter": {
                "Set_requiredAction": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "9d16cf9d-d4e6-4689-b1a0-92fa0a6285a2"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "message",
                "value": "@{if(less(coalesce(outputs('Initialize_connection')?['statusCode'],0),300),'Connected and initialized.',if(equals(coalesce(body('Initialize_connection')?['errorCode'],''),'MissingInitializationStrategy'),'Workspace and repository both contain items. Choose which side wins.',string(body('Initialize_connection'))))}"
              }
            },
            "Set_operationId_probe": {
              "runAfter": {
                "Set_message": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "b0a3d91d-3781-49df-b1dd-4fc63274fb20"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "operationId",
                "value": "@{coalesce(outputs('Initialize_connection')?['headers']?['x-ms-operation-id'], outputs('Initialize_connection')?['headers']?['X-Ms-Operation-Id'], last(split(coalesce(outputs('Initialize_connection')?['headers']?['Location'],''),'/')), '')}"
              }
            },
            "Set_outcome_connectfailed": {
              "runAfter": {
                "Connect": [
                  "Failed"
                ]
              },
              "metadata": {
                "operationMetadataId": "77c01563-5feb-400c-94e5-efc3151e4ddc"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "outcome",
                "value": "Failed"
              }
            },
            "Set_message_connectfailed": {
              "runAfter": {
                "Set_outcome_connectfailed": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "04be6967-17aa-402d-844e-7deac1925ce3"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "message",
                "value": "@{string(body('Connect'))}"
              }
            }
          },
          "runAfter": {
            "Check_existing": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Set_variable_no_outcome": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "dcf05825-1ec6-415a-a99d-3dd88e54effb"
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "outcome",
                  "value": "AlreadyConnected"
                }
              },
              "Set_variable_no_message": {
                "runAfter": {
                  "Set_variable_no_outcome": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "4729636a-a961-4b3a-8fae-e748d28139f4"
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "message",
                  "value": "Workspace is already connected to a repository."
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@body('Check_existing')?['gitConnectionState']",
              "NotConnected"
            ]
          },
          "metadata": {
            "operationMetadataId": "5829bc88-3238-4c90-921c-2af4d08d2be4"
          },
          "type": "If"
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Is_not_connected": [
              "Succeeded",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "75a013cf-374c-444e-9d2c-14a339208d39"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "outcome": "@variables('outcome')",
              "message": "@variables('message')",
              "operationid": "@variables('operationId')",
              "requiredaction": "@variables('requiredAction')"
            },
            "schema": {
              "type": "object",
              "properties": {
                "outcome": {
                  "title": "outcome",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "message": {
                  "title": "message",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "operationid": {
                  "title": "operationId",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "requiredaction": {
                  "title": "requiredAction",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Initialize_requiredAction": {
          "runAfter": {
            "Initialize_operationId": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "0de0f933-3487-4e7a-9d97-2e1b6ecbf949"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "requiredAction",
                "type": "string",
                "value": "None"
              }
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
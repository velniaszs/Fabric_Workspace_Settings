{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "8a7e54c5-4dea-436d-8d5b-ce1eca30cdc1"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "operationId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "accessToken",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_status": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "69e92aab-f37c-46fd-b45e-ea963d0518b8"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "status",
                "type": "string",
                "value": "Running"
              }
            ]
          }
        },
        "Do_until": {
          "actions": {
            "Delay": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "4259f44e-ad4b-4352-a04a-9aa046646ac7"
              },
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 5,
                  "unit": "Second"
                }
              }
            },
            "HTTP": {
              "runAfter": {
                "Delay": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "87ee8d0a-9957-4535-805e-53c938517984"
              },
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "https://api.fabric.microsoft.com/v1/operations/@{triggerBody()['text']}",
                "headers": {
                  "Authorization": "Bearer @{triggerBody()?['text_1']}",
                  "Accept": "application/json"
                }
              }
            },
            "Set_variable_status": {
              "runAfter": {
                "HTTP": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "52bd7fb7-eb6b-43c3-ba95-8426abb1133a"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "status",
                "value": "@{coalesce(body('HTTP')?['status'], 'Undefined')}"
              }
            },
            "Set_variable_errorCode": {
              "runAfter": {
                "Set_variable_status": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "622aa895-e054-402a-bf90-5a1cce6561ed"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "errorCode",
                "value": "@{coalesce(body('HTTP')?['error']?['errorCode'], '')}"
              }
            },
            "Set_variable_errorMessage": {
              "runAfter": {
                "Set_variable_errorCode": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "1dc975f3-161b-437d-914f-2b46bdb378ac"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "errorMessage",
                "value": "@{coalesce(body('HTTP')?['error']?['message'], '')}"
              }
            },
            "Set_variable_isDone": {
              "runAfter": {
                "Increment_variable_attempts": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "c63675d0-315d-403f-9680-fa4b34c9ff6b"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "isDone",
                "value": "@or(equals(variables('status'),'Succeeded'), equals(variables('status'),'Failed'))"
              }
            },
            "Increment_variable_attempts": {
              "runAfter": {
                "Set_variable_errorMessage": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d5505322-8352-430a-a3e7-49a6501bf11b"
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "attempts",
                "value": 1
              }
            }
          },
          "runAfter": {
            "Initialize_attempts": [
              "Succeeded"
            ]
          },
          "expression": "@equals(variables('isDone'), true)",
          "limit": {
            "count": 60,
            "timeout": "PT10M"
          },
          "metadata": {
            "operationMetadataId": "9ac17caf-16b9-424d-abfd-b10f99f8c2e0"
          },
          "type": "Until"
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Condition": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1e09dde5-93fa-41bb-ae51-a56fc8d649c4"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "status": "@variables('status')",
              "errorcode": "@variables('errorCode')",
              "errormessage": "@variables('errorMessage')",
              "attempts": "@{variables('attempts')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "title": "status",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "errorcode": {
                  "title": "errorCode",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "errormessage": {
                  "title": "errorMessage",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "attempts": {
                  "title": "attempts",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Initialize_errorCode": {
          "runAfter": {
            "Initialize_status": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5894cb7f-54ae-4354-9383-d84cb3d6ad66"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "errorCode",
                "type": "string"
              }
            ]
          }
        },
        "Initialize_errorMessage": {
          "runAfter": {
            "Initialize_errorCode": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "bd9f1a68-da41-4427-8ab8-c74aae15d788"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "errorMessage",
                "type": "string"
              }
            ]
          }
        },
        "Initialize_isDone": {
          "runAfter": {
            "Initialize_errorMessage": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "45638627-89a8-47de-bc0d-5d6a8b9c5abb"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "isDone",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Initialize_attempts": {
          "runAfter": {
            "Initialize_isDone": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "2ae40f85-42aa-47b2-9523-1f9a5e933042"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "attempts",
                "type": "integer",
                "value": 0
              }
            ]
          }
        },
        "Condition": {
          "actions": {},
          "runAfter": {
            "Do_until": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Set_variable": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "c2a6dafc-409e-4d61-8414-787da0a6fbbf"
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "status",
                  "value": "TimedOut"
                }
              },
              "Set_variable_2": {
                "runAfter": {
                  "Set_variable": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "18285f37-eab8-42b2-9bae-709a95665cb4"
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "errorMessage",
                  "value": "@{concat('Operation did not complete after ', string(variables('attempts')), ' attempts')}"
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@variables('isDone')",
              "@true"
            ]
          },
          "metadata": {
            "operationMetadataId": "165c602b-34fb-43b9-ae34-5aec37d77055"
          },
          "type": "If"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
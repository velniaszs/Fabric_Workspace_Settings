          "metadata": {
            "operationMetadataId": "b9e826fb-b783-4c5f-bdaf-6bb5e3e1a6ca"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "rulesjson": "@{string(body('HTTP_2'))}",
              "etag": "@{outputs('HTTP_2')?['headers']?['ETag']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "rulesjson": {
                  "title": "RulesJson",
                  "x-ms-dynamically-added": true,

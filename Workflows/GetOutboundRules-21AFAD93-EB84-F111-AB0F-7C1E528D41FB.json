                  "type": "string"
                }
              }
            }
          }
        },
        "Run_a_Child_Flow": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "57d82afd-3230-45dc-88a9-c2b73f40654b"
          },
          "type": "Workflow",
          "inputs": {
            "host": {
              "workflowReferenceName": "50895fca-088f-f111-8076-7ced8d76bf1b"
            }
          }
        }
      }
    },
    "templateName": ""
